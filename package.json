{
  "name": "pi-voice-win",
  "version": "0.3.0",
  "description": "Hold Space to dictate in the pi coding agent. Windows-native, offline STT (Parakeet TDT v3), Spanish/English auto-detected, no sox/ffmpeg/API key.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "speech-to-text",
    "stt",
    "windows",
    "parakeet",
    "sherpa-onnx",
    "offline"
  ],
  "os": [
    "win32"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "npx tsx hold.ts",
    "bench": "npx tsx bench.ts"
  },
  "dependencies": {
    "decibri": "^3.4.2",
    "sherpa-onnx-node": "^1.13.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "author": "axvg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axvg/pi-voice-win.git"
  },
  "homepage": "https://axvg.github.io/pi-voice-win/",
  "bugs": {
    "url": "https://github.com/axvg/pi-voice-win/issues"
  },
  "files": [
    "index.ts",
    "stt.ts",
    "hold.ts",
    "worker.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
